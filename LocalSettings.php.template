$wgHooks['MediaWikiServices'][] = function( \MediaWiki\MediaWikiServices $services ) {
    global $wgLocalFileRepo, $wgAWSBucketName, $wgAWSBucketDomain, $wgAWSBucketTopSubdirectory, $wgFileBackends;
    
    // Only proceed if bucket name is configured
    if ( empty( $wgAWSBucketName ) ) {
        return;
    }
    
    // Construct the correct public URL for path-style endpoints
    // Format: https://storage.googleapis.com/bucket-name/images/file.jpg
    $subdir = isset( $wgAWSBucketTopSubdirectory ) ? $wgAWSBucketTopSubdirectory : '';
    // Use base domain (not $wgAWSBucketDomain which has /$1 for Extension:AWS)
    $domain = $_ENV['GCS_BUCKET_DOMAIN'] ?? 'storage.googleapis.com';
    $publicUrl = "https://{$domain}/{$wgAWSBucketName}{$subdir}";
    
    // Set URL on file repo configuration
    if ( isset( $wgLocalFileRepo ) && is_array( $wgLocalFileRepo ) ) {
        $wgLocalFileRepo['url'] = $publicUrl;
    }
    
    // CRITICAL: Also set zone URLs on the backend configuration
    // Extension:AWS uses backend container paths to generate image URLs
    // For path-style endpoints, we need to ensure these include the bucket name
    if ( isset( $wgFileBackends['s3'] ) && is_array( $wgFileBackends['s3'] ) ) {
        // Ensure backend has a name (required by MediaWiki)
        if ( !isset( $wgFileBackends['s3']['name'] ) ) {
            $wgFileBackends['s3']['name'] = 's3';
        }
        
        // Ensure container name is set to bucket name for path-style endpoints
        if ( !isset( $wgFileBackends['s3']['container'] ) ) {
            $wgFileBackends['s3']['container'] = $wgAWSBucketName;
        }
        
        // CRITICAL: Configure container paths with URLs that include bucket name
        // Extension:AWS uses these to generate image URLs, so they must include bucket name
        $thumbUrl = "https://{$domain}/{$wgAWSBucketName}{$subdir}/thumb";
        
        $wgFileBackends['s3']['containerPaths'] = [
            'public' => [
                'container' => $wgAWSBucketName,
                'directory' => ltrim( $subdir, '/' ),
                'url' => $publicUrl // Full URL with bucket name in path
            ],
            'thumb' => [
                'container' => $wgAWSBucketName,
                'directory' => ltrim( $subdir, '/' ) . '/thumb',
                'url' => $thumbUrl // Full URL with bucket name in path
            ]
        ];
        
        // Also set publicUrl for backward compatibility
        $wgFileBackends['s3']['publicUrl'] = $publicUrl;
        
        // Debug logging removed - uncomment for troubleshooting if needed
        // error_log( "Configured backend container paths - public: {$publicUrl}, thumb: {$thumbUrl}" );
    }
    
    // Configure zone URLs in $wgLocalFileRepo
    // MediaWiki uses these to generate URLs for different file zones
    if ( isset( $wgLocalFileRepo ) && is_array( $wgLocalFileRepo ) ) {
        $thumbUrl = "https://{$domain}/{$wgAWSBucketName}{$subdir}/thumb";
        
        if ( !isset( $wgLocalFileRepo['zones'] ) || !is_array( $wgLocalFileRepo['zones'] ) ) {
            $wgLocalFileRepo['zones'] = [];
        }
        
        // Set public zone URL (for full-size images)
        $wgLocalFileRepo['zones']['public'] = [
            'url' => $publicUrl
        ];
        
        // Set thumb zone URL (for thumbnails)
        $wgLocalFileRepo['zones']['thumb'] = [
            'url' => $thumbUrl
        ];
        
        // Debug logging removed - uncomment for troubleshooting if needed
        // error_log( "Configured zone URLs in \$wgLocalFileRepo - public: {$publicUrl}, thumb: {$thumbUrl}" );
    }
    
    // Note: We configure zones in $wgLocalFileRepo above, which MediaWiki will use
    // Extension:AWS should respect this configuration when it initializes the repo
    // If Extension:AWS overrides it, we may need to patch Extension:AWS or use a different approach
};

