# ResourceLoader performance debugging
# Track timing to identify bottlenecks in startup module loading
$wgHooks['ResourceLoaderGetConfigVars'][] = function( &$vars, $skin, $config ) {
	// Record start time for ResourceLoader initialization
	$vars['wgResourceLoaderStartTime'] = microtime( true );
	// Log to error log for server-side debugging
	error_log( '[ResourceLoader] Config vars requested at: ' . $vars['wgResourceLoaderStartTime'] );
};

# Hook into ResourceLoader module registration to track timing
$wgHooks['ResourceLoaderRegisterModules'][] = function( $resourceLoader ) {
	$startTime = microtime( true );
	error_log( '[ResourceLoader] Module registration started at: ' . $startTime );
	$moduleCount = count( $resourceLoader->getModuleNames() );
	error_log( '[ResourceLoader] Total modules registered: ' . $moduleCount );
	
	// Track when modules are registered
	register_shutdown_function( function() use ( $startTime, $moduleCount ) {
		$endTime = microtime( true );
		$duration = $endTime - $startTime;
		if ( $duration > 1.0 ) {
			error_log( '[ResourceLoader] SLOW: Module registration completed in: ' . round( $duration, 3 ) . ' seconds (modules: ' . $moduleCount . ')' );
		} else {
			error_log( '[ResourceLoader] Module registration completed in: ' . round( $duration, 3 ) . ' seconds' );
		}
	} );
};

# Track page generation timing to identify ResourceLoader bottlenecks
$wgHooks['BeforePageDisplay'][] = function( $out, $skin ) {
	// Track when ResourceLoader client is being built (includes startup module generation)
	$rlStartTime = microtime( true );
	error_log( '[ResourceLoader] BeforePageDisplay hook - starting ResourceLoader client build' );
	
	// Use a shutdown function to measure total time after everything completes
	register_shutdown_function( function() use ( $rlStartTime ) {
		$rlEndTime = microtime( true );
		$rlDuration = $rlEndTime - $rlStartTime;
		error_log( '[ResourceLoader] Total page generation time: ' . round( $rlDuration, 3 ) . ' seconds' );
		
		// Log memory usage
		$memoryUsage = memory_get_peak_usage( true );
		error_log( '[ResourceLoader] Peak memory usage: ' . round( $memoryUsage / 1024 / 1024, 2 ) . ' MB' );
	} );
};

