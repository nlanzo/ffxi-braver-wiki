# Wiki URL (set this to your Cloud Run service URL)
$wgServer = $_ENV['WIKI_SERVER'] ?? 'https://your-service-url.run.app';

# Secret keys (generate these and set as environment variables)
$wgSecretKey = $_ENV['WIKI_SECRET_KEY'] ?? 'your-secret-key-change-this';
$wgUpgradeKey = $_ENV['WIKI_UPGRADE_KEY'] ?? 'your-upgrade-key-change-this';

# File uploads - Use Cloud Storage via AWS extension (S3 compatibility)
# See: https://www.mediawiki.org/wiki/Extension:AWS

// Configure AWS credentials for GCS (using HMAC keys from GCS Interoperability)
$wgAWSCredentials = [
    'key' => $_ENV['GCS_ACCESS_KEY'] ?? '',
    'secret' => $_ENV['GCS_SECRET_KEY'] ?? '',
    'token' => false
];

// GCS endpoint configuration - CRITICAL for GCS compatibility
// According to Extension:AWS README for non-Amazon S3-compatible services:
// https://github.com/edwardspec/mediawiki-aws-s3/blob/master/README.md
$wgAWSRegion = 'auto'; // Required even for GCS

// Your GCS bucket name
$wgAWSBucketName = $_ENV['GCS_BUCKET_NAME'] ?? '';

// GCS endpoint domain for public URLs
// For path-style endpoints, Extension:AWS needs the bucket name in the domain
// Format: https://storage.googleapis.com/bucket-name/file.jpg
// However, since we're using a private bucket, we'll serve through img_auth.php instead
// Set this to include bucket name for reference, but img_auth.php will be used for actual serving
$wgAWSBucketDomain = $_ENV['GCS_BUCKET_DOMAIN'] ?? 'storage.googleapis.com';

// CRITICAL: Configure file backend to use GCS endpoint instead of AWS S3
// This must be set BEFORE loading Extension:AWS
// See: https://github.com/edwardspec/mediawiki-aws-s3/blob/master/README.md#non-standard-configuration
if ( !isset( $wgFileBackends ) || !is_array( $wgFileBackends ) ) {
    $wgFileBackends = [];
}
$wgFileBackends['s3']['endpoint'] = "https://{$wgAWSBucketDomain}";
$wgFileBackends['s3']['use_path_style_endpoint'] = true; // Required for GCS (doesn't use subdomains)
// For private bucket, we'll serve through img_auth.php, so don't set public URL here

// Load Extension:AWS - it will use the endpoint configuration above
wfLoadExtension( 'AWS' );

// Ensure URL is configured correctly after Extension:AWS loads
// Extension:AWS might try to set public URLs, but we want to use img_auth.php for private bucket
// Use a hook that runs after Extension:AWS's MediaWikiServices hook
$wgHooks['MediaWikiServices'][] = function( \MediaWiki\MediaWikiServices $services ) {
    global $wgLocalFileRepo, $wgScriptPath, $wgFileBackends;
    
    // Force URL to use img_auth.php for private bucket
    // This ensures images are served through MediaWiki's authentication, not direct GCS URLs
    if ( isset( $wgLocalFileRepo ) && is_array( $wgLocalFileRepo ) ) {
        $wgLocalFileRepo['url'] = $wgScriptPath . '/img_auth.php';
        $wgLocalFileRepo['scriptDirUrl'] = $wgScriptPath;
    }
    
    // Also ensure the file backend doesn't try to use direct GCS URLs
    // Configure zone URLs to use img_auth.php
    if ( isset( $wgFileBackends['s3'] ) && is_array( $wgFileBackends['s3'] ) ) {
        // Don't set public URLs - let MediaWiki use img_auth.php instead
        // Extension:AWS might try to set these, but we override them
        if ( isset( $wgFileBackends['s3']['publicUrl'] ) ) {
            unset( $wgFileBackends['s3']['publicUrl'] );
        }
    }
    
    error_log( "Configured file repository to use img_auth.php for private bucket" );
};

