# Protect against web entry
if ( !defined( 'MEDIAWIKI' ) ) {
	exit;
}

# Database settings
# For Cloud SQL, use Unix socket connection
# Format: localhost:/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
if (isset($_ENV['CLOUD_SQL_CONNECTION_NAME'])) {
    $wgDBserver = 'localhost:/cloudsql/' . $_ENV['CLOUD_SQL_CONNECTION_NAME'];
} else {
    $wgDBserver = $_ENV['DB_HOST'] ?? 'localhost';
}

$wgDBname = $_ENV['DB_NAME'] ?? 'mediawiki';
$wgDBuser = $_ENV['DB_USER'] ?? 'mediawiki';
$wgDBpassword = $_ENV['DB_PASSWORD'] ?? '';

# Database type (mysql or postgres)
$wgDBtype = $_ENV['DB_TYPE'] ?? 'mysql';

# Force InnoDB engine (Cloud SQL doesn't support MyISAM)
# This must be set before installation/upgrade
$wgDBTableOptions = 'ENGINE=InnoDB, DEFAULT CHARSET=utf8mb4';

# Wiki name
$wgSitename = $_ENV['WIKI_SITENAME'] ?? 'My Wiki';
$wgMetaNamespace = str_replace(' ', '_', $wgSitename);

# Site Logo
# You can set this via environment variable WIKI_LOGO_URL
# Example: https://storage.googleapis.com/your-bucket/logo.png
$wgLogos = [
    '1x' => $_ENV['WIKI_LOGO_URL'] ?? '',
];

## The URL base path to the directory containing the wiki;
## defaults for all runtime URL paths are based off of this.
$wgScriptPath = "";

# Wiki URL (set this to your Cloud Run service URL)
$wgServer = $_ENV['WIKI_SERVER'] ?? 'https://your-service-url.run.app';

# Secret keys (generate these and set as environment variables)
$wgSecretKey = $_ENV['WIKI_SECRET_KEY'] ?? 'your-secret-key-change-this';
$wgUpgradeKey = $_ENV['WIKI_UPGRADE_KEY'] ?? 'your-upgrade-key-change-this';

# File uploads - Use Cloud Storage API via ExternalStorage extension
# ExternalStorage extension is installed in the Docker image
# Configure ExternalStorage to use Google Cloud Storage backend
# See: https://www.mediawiki.org/wiki/Extension:ExternalStorage
$wgUploadDirectory = "$IP/images";
$wgUploadPath = '/images';

# Security: Nginx is configured to prevent PHP execution in /images/ directory
# and to add X-Content-Type-Options: nosniff header
# This addresses the MediaWiki installer security warnings

# Temporary directory (use in-memory tmpfs for Cloud Run)
$wgTmpDirectory = sys_get_temp_dir();

# Enable uploads
$wgEnableUploads = true;

# Cache settings (use Redis or Memcached if available)
if (isset($_ENV['REDIS_HOST'])) {
    $wgObjectCaches['redis'] = [
        'class' => 'RedisBagOStuff',
        'servers' => [$_ENV['REDIS_HOST'] . ':' . ($_ENV['REDIS_PORT'] ?? 6379)],
    ];
    $wgMainCacheType = 'redis';
    $wgSessionCacheType = 'redis';
}

# Performance settings for Cloud Run
$wgUseImageMagick = false;
$wgShellLocale = 'en_US.UTF-8';
$wgLanguageCode = $_ENV['WIKI_LANGUAGE'] ?? 'en';

# Security settings
$wgEnableAPI = true;
$wgEnableWriteAPI = true;
$wgCrossSiteAJAXdomains = ['*'];

# Email settings - REQUIRED for email confirmation
$wgEnableEmail = true;
$wgEnableUserEmail = true; # UPO

# Email sender configuration - REQUIRED for sending emails
# Set these to valid email addresses for your domain
# These can be set via environment variables or defaults will be used
$wgEmergencyContact = $_ENV['WIKI_EMERGENCY_CONTACT'] ?? 'wikiadmin@' . parse_url($_ENV['WIKI_SERVER'] ?? 'https://your-service-url.run.app', PHP_URL_HOST);
$wgPasswordSender = $_ENV['WIKI_PASSWORD_SENDER'] ?? 'noreply@' . parse_url($_ENV['WIKI_SERVER'] ?? 'https://your-service-url.run.app', PHP_URL_HOST);

# Email authentication and confirmation settings
$wgEmailAuthentication = true;
$wgEmailConfirmToEdit = true; # Require confirmed email to edit

# SMTP Configuration - REQUIRED for sending confirmation emails
# MediaWiki will use SMTP if configured, otherwise falls back to PHP mail()
# Configure SMTP using environment variables
if (isset($_ENV['SMTP_HOST'])) {
    $wgSMTP = [
        'host' => $_ENV['SMTP_HOST'],
        'port' => $_ENV['SMTP_PORT'] ?? 587,
        'auth' => true,
        'username' => $_ENV['SMTP_USERNAME'] ?? '',
        'password' => $_ENV['SMTP_PASSWORD'] ?? '',
        'IDHost' => parse_url($_ENV['WIKI_SERVER'] ?? 'https://your-service-url.run.app', PHP_URL_HOST),
    ];
}

# Logging
$wgDebugLogFile = '/dev/stderr';
# Temporarily enable error display for debugging (disable in production)
$wgShowExceptionDetails = true;
$wgShowSQLErrors = true;
$wgShowDBErrorBacktrace = true;

# Increase PCRE limits for large page parsing
ini_set( 'pcre.backtrack_limit', '2000000' );
ini_set( 'pcre.recursion_limit', '200000' );

# Additional settings
$wgResourceBasePath = $wgScriptPath;
$wgStylePath = "$wgResourceBasePath/skins";
$wgLocalStylePath = "$wgResourceBasePath/skins";

# Default skin
$wgDefaultSkin = 'vector';

# Enabled skins (add more as needed)
wfLoadSkin( 'MinervaNeue' );
wfLoadSkin( 'MonoBook' );
wfLoadSkin( 'Timeless' );
wfLoadSkin( 'Vector' );

# Permissions - restrict edits to logged-in users only
$wgGroupPermissions["*"]["edit"] = false;

# Load extensions
wfLoadExtension( 'VisualEditor' );

